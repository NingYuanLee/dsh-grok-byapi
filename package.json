{
  "name": "dsh-grok-byapi",
  "version": "0.2.0-alpha.2",
  "displayName": "Grok ByAPI",
  "description": "Native Grok for DeepSeek Harness: chat provider, image and video generation, TTS, and durable local media tasks over any OpenAI-compatible Grok gateway.",
  "license": "MIT",
  "author": "NingYuanLee",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./catalog": "./src/catalog.js",
    "./imagine": "./src/media-entry.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./imagine/icon": "./assets/imagine.svg",
    "./imagine/locale/*.json": "./locale/imagine/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "assets",
    "icon.svg",
    "lib/client.js",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "locale",
    "docs/assets/banner.svg",
    "docs/assets/showcase.jpg",
    "docs/assets/screenshot-plugins.jpg",
    "docs/assets/screenshot-settings.jpg",
    "screenshots.json",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/adapter.js && node --check src/catalog.js && node --check src/media.js && node --check src/media-entry.js && node --check src/service.js && node --check src/client.js && node --check scripts/build-client.mjs",
    "prepublishOnly": "npm test && npm run check"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NingYuanLee/dsh-grok-byapi.git"
  },
  "homepage": "https://github.com/NingYuanLee/dsh-grok-byapi#readme",
  "bugs": {
    "url": "https://github.com/NingYuanLee/dsh-grok-byapi/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "grok",
    "xai",
    "grok-imagine",
    "llm-provider",
    "ai-agent",
    "image-generation",
    "video-generation",
    "text-to-speech",
    "openai-compatible"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "alpha"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-settings-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-0 <0.3.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1"
  },
  "icon": "./icon.svg"
}